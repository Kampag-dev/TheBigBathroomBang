<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Panic Key Redirect</title>
  <script>
    document.addEventListener("keydown", function(event) {
      if (event.key === "Escape") {
        window.location.href = "https://www.ixl.com";
      }
    });
  </script>
</head>
<body>
  <h2>This is your embedded page.</h2>
  <p>Press <strong>Esc</strong> to quickly switch to IXL.</p>
</body>
</html>
